# Example nginx configuration for AIO Voice Connect
#
# Place this in /etc/nginx/sites-available/aio-voice-connect
# then: sudo ln -s /etc/nginx/sites-available/aio-voice-connect /etc/nginx/sites-enabled/
#       sudo nginx -t && sudo systemctl reload nginx
#
# Assumptions:
#   - API server runs on port 8080 (managed by PM2 or systemd)
#   - Frontend is built to: /opt/aio-voice-connect/artifacts/aio-voice-connect-manager/dist/public
#   - SSL managed by certbot (run: sudo certbot --nginx -d your-domain.com)

server {
    listen 80;
    server_name your-domain.com;

    # Redirect HTTP → HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name your-domain.com;

    # SSL — managed by certbot (it will fill these in automatically)
    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # ── Frontend static files ───────────────────────────────────────────────
    root /opt/aio-voice-connect/artifacts/aio-voice-connect-manager/dist/public;
    index index.html;

    # Serve the React SPA — any path not matched below falls through to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── API reverse proxy ───────────────────────────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Long-poll / streaming endpoints (outbound context waits up to 25 s)
        proxy_read_timeout  60s;
        proxy_send_timeout  60s;

        # Disable buffering so SSE / streaming logs reach the client immediately
        proxy_buffering off;
    }

    # ── Security headers ────────────────────────────────────────────────────
    add_header X-Frame-Options      SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy      strict-origin-when-cross-origin;
}
