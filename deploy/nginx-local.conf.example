# nginx config for LOCAL / TEST phase — HTTP only, no domain required.
# Use your VM's IP address (e.g. 192.168.1.100) instead of a real domain.
#
# Install:
#   sudo cp deploy/nginx-local.conf.example /etc/nginx/sites-available/aio-voice-connect
#   sudo ln -s /etc/nginx/sites-available/aio-voice-connect /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then open:  http://<vm-ip>/           (dashboard)
#             http://<vm-ip>/api/healthz (API healthcheck)
#
# Switch to deploy/nginx.conf.example (HTTPS) when going to production.

server {
    listen 80;
    server_name _;          # matches any hostname or bare IP address

    # ── Frontend static files ─────────────────────────────────────────────────
    root /opt/aio-voice-connect/artifacts/aio-voice-connect-manager/dist/public;
    index index.html;

    # SPA fallback — all unmatched paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── API reverse proxy ─────────────────────────────────────────────────────
    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Outbound context endpoint long-polls up to 25 s — give it headroom
        proxy_read_timeout  60s;
        proxy_send_timeout  60s;
        proxy_buffering     off;
    }
}
