# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/aio_voice_connect
DATABASE_URL=postgresql://user:password@localhost:5432/aio_voice_connect

# Express session signing key — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Outbound call API auth ─────────────────────────────────────────────────────
# Static API key for POST /api/outbound/call (X-Api-Key header).
# Leave blank if you prefer to manage keys via the dashboard (API page → API Keys).
# If set, this key is accepted in addition to any dashboard-generated keys.
OUTBOUND_API_KEY=

# ── Optional: Yeastar P-Series PBX ────────────────────────────────────────────
# These are stored per-IPBX in the dashboard (IPBX → Edit).
# You do NOT need to set them here — they live in the database.
# Shown here for reference only.
# YEASTAR_API_URL=https://your-pbx.example.com
# YEASTAR_CLIENT_ID=your-client-id
# YEASTAR_CLIENT_SECRET=your-client-secret

# ── Node environment ───────────────────────────────────────────────────────────
NODE_ENV=production
